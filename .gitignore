# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel — 2026-08-12에 GitHub Pages로 이전했다. 배포는 .github/workflows/pages.yml이 한다.
# 이 프로젝트는 더 이상 Vercel을 쓰지 않지만, CLI를 한 번이라도 돌리면 .vercel/이 생기므로
# 실수로 커밋되지 않게 무시는 유지한다.
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (개인 설정만 제외. CLAUDE.md와 .claude/skills는 커밋한다)
.claude/settings.local.json

# frontmatter 에이전트 작업 파일 (요청/응답)
.frontmatter/
